{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screenguard",
  "version": "0.2.8",
  "identifier": "com.nanyu.screenguard",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "屏幕守护",
        "label": "main",
        "width": 780,
        "height": 700,
        "minWidth": 420,
        "minHeight": 520,
        "resizable": true,
        "center": true
      },
      {
        "label": "panel",
        "url": "panel.html",
        "width": 380,
        "height": 568,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "publisher": "nanyu",
    "copyright": "Copyright © 2026 陆冠霖",
    "shortDescription": "跨平台显示器控制与多屏助手",
    "longDescription": "屏幕守护（Screenguard）：跨平台显示器控制与多屏助手。DDC/CI 亮度音量、色彩同步、副屏横竖切换、双屏铺满看电影、开机自启。",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    }
  }
}
