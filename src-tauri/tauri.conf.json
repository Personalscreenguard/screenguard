{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screenguard",
  "version": "0.2.3",
  "identifier": "com.nanyu.screenguard",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "屏幕守护",
        "label": "main",
        "width": 780,
        "height": 700,
        "minWidth": 420,
        "minHeight": 520,
        "resizable": true,
        "center": true
      },
      {
        "label": "panel",
        "url": "panel.html",
        "width": 380,
        "height": 568,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}